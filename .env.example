# ==============================================
# FinApp v2 - Backend Environment Configuration
# ==============================================

# Server Port (default: 3333)
PORT=3333

# SQLite Database Connection String
DATABASE_URL="file:./dev.db"

# JWT Secret Key for Session Authentication
# IMPORTANT: In production, generate a secure 64-char random secret
JWT_SECRET="finapp_production_secret_key_change_in_production_2026"

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_ID=""
